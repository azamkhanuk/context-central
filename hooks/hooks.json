{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact|fork", "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/context-central", "hook", "session-start"], "bash": "node \"$CLAUDE_PLUGIN_ROOT/bin/context-central\" hook session-start", "powershell": "$payload = [Console]::In.ReadToEnd(); if (-not $payload) { $payload = @($input) -join [Environment]::NewLine }; $payload | node (Join-Path $env:CLAUDE_PLUGIN_ROOT 'bin/context-central') hook session-start; exit $LASTEXITCODE", "timeout": 15 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/bin/context-central", "hook", "user-prompt-submit"], "bash": "node \"$CLAUDE_PLUGIN_ROOT/bin/context-central\" hook user-prompt-submit", "powershell": "$payload = [Console]::In.ReadToEnd(); if (-not $payload) { $payload = @($input) -join [Environment]::NewLine }; $payload | node (Join-Path $env:CLAUDE_PLUGIN_ROOT 'bin/context-central') hook user-prompt-submit; exit $LASTEXITCODE", "timeout": 10 }] }
    ]
  }
}
