#!/usr/bin/env node
const { join } = require('path')
const { pathToFileURL } = require('url')

const NEEDS = [22, 18]
const [major, minor] = process.versions.node.split('.').map(Number)

if (major < NEEDS[0] || (major === NEEDS[0] && minor < NEEDS[1])) {
  const message = 'context-central: this is Node ' + process.versions.node + '; the plugin needs Node ' + NEEDS.join('.') + ' or later.'
  const [command, event] = process.argv.slice(2)
  if (command !== 'hook') {
    console.error(message)
    process.exitCode = 1
  } else if (event === 'session-start') {
    console.log(JSON.stringify({ systemMessage: message + ' Its hooks stay quiet until then.' }))
  }
} else {
  const nodeModule = require('module')
  // Node 24 keeps the stripped TypeScript in its compile cache, so a start costs what plain JavaScript did.
  if (nodeModule.enableCompileCache) nodeModule.enableCompileCache()
  import(pathToFileURL(join(__dirname, '..', 'lib', 'cli.mts')).href)
    .then(cli => cli.main(process.argv.slice(2)))
    .then(code => {
      process.exitCode = code
    })
}
